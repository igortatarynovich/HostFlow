  "entity_deep_links": {
    "candidate": { "host": "recruitment", "path_template": "/app/candidates/{id}" },
    "recruitment_application": { "host": "recruitment", "path_template": "/app/recruitment/inbox/{id}" },
    "vacancy": { "host": "recruitment", "path_template": "/app/vacancies/{id}" },
    "search": { "host": "recruitment", "path_template": "/app/vacancies/{id}", "notes": "Legacy search id == vacancy id; operator surface redirects via SPA" },
    "lead": { "host": "recruitment", "path_template": "/app/leads/{id}", "notes": "Recruitment transport lead card; sales inquiry uses inquiry" },
    "employee": { "host": "hr", "path_template": "/app/hr/employees/{id}" },
    "inquiry": { "host": "sales", "path_template": "/app/sales/inquiries/{id}" },
    "client_account": { "host": "sales", "path_template": "/app/clients/{id}" },
    "service_order": { "host": "sales", "path_template": "/app/services?tab=orders&order={id}", "notes": "Services capability deploys under Sales host — not a sixth product module" },
    "vehicle": { "host": "fleet", "path_template": "/app/fleet/vehicles/{id}" },
    "invoice": { "host": "finance", "path_template": "/app/invoices/{id}" },
    "payment": { "host": "finance", "path_template": "/app/invoices?payment={id}" }
  },
  "entity_type_aliases": {
    "company": "client_account",
    "client": "client_account",
    "workforce_employee": "employee",
    "hr_employee": "employee",
    "sales_inquiry": "inquiry",
    "recruitment_lead": "lead",
    "order": "service_order",
    "service-order": "service_order",
    "fleet_vehicle": "vehicle"
  },
  "deep_link_query_allowlist": ["tab", "order", "order_id", "payment", "focus", "channel", "company_id", "view", "action"],
  "shell_entity_types": ["communication_thread", "thread", "task", "reminder", "document", "document_step"],
  "auth_handoff": {
    "status": "removed_stage_6b",
    "hash_prefix": "hf_auth=",
    "note": "Hash handoff deleted in Stage 6B; use shared session cookies."
  },
  "session_cookies": {
    "domain": ".hostflow.cc",
    "access": "hf_access",
    "refresh": "hf_refresh",
    "csrf": "hf_csrf",
    "samesite": "lax",
    "secure": true,
    "httponly_access_refresh": true
  }
}
