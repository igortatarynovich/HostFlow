      {
        "name": "spa_candidate_documents",
        "params": [
          "candidate_id: str"
        ],
        "body": "return f\"{CANDIDATES}/{candidate_id}/documents\""
      },
      {
        "name": "spa_client",
        "params": [
          "company_id: str"
        ],
        "body": "return f\"{CLIENTS}/{company_id}\""
      },
      {
        "name": "spa_lead",
        "params": [
          "lead_id: str"
        ],
        "body": "return f\"{LEADS}/{lead_id}\""
      },
      {
        "name": "spa_vacancy",
        "params": [
