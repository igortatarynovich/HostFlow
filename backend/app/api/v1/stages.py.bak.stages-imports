router = APIRouter(prefix="/stages", tags=["stages"])


def _norm_stage(val: Optional[str]) -> Optional[str]:
    if not val:
        return None
    v = val.strip()
    if is_stage_code(v):
        return v
    return code_for_label(v)


@router.get("")
async def list_stages() -> Dict[str, Optional[str]]:
    """
    Возвращает карту {code: label}. Если STAGES отсутствует — вернём {}.
    """
    out: Dict[str, Optional[str]] = {}
    for it in STAGES:
        code = str(it.get("code", "")).strip()
        label = it.get("label")
        out[code] = str(label) if label is not None else None
    return out


@router.get("/summary")
async def stages_summary(
    db_tenant: Tuple[AsyncSession, UUID] = Depends(get_db_with_tenant),
    manager: Optional[str] = Query(None),
    company_id: Optional[UUID] = Query(None),
    vacancy_id: Optional[UUID] = Query(None),
):
    """
    { by_stage: {code: count} } по фильтрам.
    """
    db, tenant_id = db_tenant
    conds = [
        Candidate.tenant_id == str(tenant_id),
        Candidate.deleted_at.is_(None),
    ]
    if manager:
        conds.append(Candidate.manager == manager)
    if company_id:
        conds.append(Candidate.company_id == str(company_id))
    if vacancy_id:
        conds.append(Candidate.vacancy_id == str(vacancy_id))

    rows = await db.execute(
        select(Candidate.stage, func.count()).where(*conds).group_by(Candidate.stage)
    )
    by_stage = {k or "": int(v) for k, v in rows.all()}
    return {"by_stage": by_stage}


@router.get("/normalize")
async def normalize_stage(value: str) -> Dict[str, Optional[str]]:
    """
    Нормализация: принимает code или label, возвращает {code, label}.
    """
    code = _norm_stage(value) or DEFAULT_STAGE_CODE
    label = label_for_code(code)
    return {"code": code, "label": label}
