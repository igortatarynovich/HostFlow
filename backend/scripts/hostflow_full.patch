+# --- ensure short_id helper ---------------------------------------------------
+def _ensure_short_id(db: Session, cand: Candidate):
+    """
+    Назначить уникальный short_id, если его нет.
+    """
+    if getattr(cand, "short_id", None):
+        return
+    # до 5 попыток с коллизиями
+    for _ in range(5):
+        sid = make_short_id()
+        if not db.query(Candidate).filter(Candidate.short_id == sid).first():
+            cand.short_id = sid
+            break
 
