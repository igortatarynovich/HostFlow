+import random
+
+def make_short_id(n: int = 6) -> str:
+    """
+    Генератор короткого ID из читаемых символов (без 0/O/1/I).
+    """
+    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+    return "".join(random.choice(alphabet) for _ in range(n))
+
