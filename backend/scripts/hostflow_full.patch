@@ -0,0 +1,29 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+@layer base {
+  html { @apply text-gray-900 bg-gray-50 font-sans antialiased; }
+}
+
+@layer components {
+  .card       { @apply bg-white rounded-xl shadow-card border border-gray-200; }
+  .label      { @apply mb-1.5 text-sm font-medium text-gray-700; }
+  .input      { @apply w-full rounded-xl border border-gray-300 bg-white px-3 py-2
+                       outline-none focus:ring-4 focus:ring-brand-100 focus:border-brand-500
+                       placeholder:text-gray-400; }
+  .btn        { @apply inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-sm font-medium; }
+  .btn-primary{ @apply btn bg-brand-500 text-white hover:bg-brand-600 active:bg-brand-700
+                       focus:ring-4 focus:ring-brand-200; }
+  .btn-ghost  { @apply btn bg-transparent text-gray-700 hover:bg-gray-100; }
+  .badge      { @apply inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs; }
+}
