:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /build {
		reverse_proxy backend:8000
	}

	handle /healthz {
		reverse_proxy backend:8000
	}

	handle /assets/* {
		root * /var/www/hostflow-frontend
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /var/www/hostflow-frontend
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
