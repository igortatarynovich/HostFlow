description: HostFlow UI composition and ADR-011. Applies when editing frontend TypeScript, TSX, or CSS.
globs: hostflow-frontend/**/*.ts,hostflow-frontend/**/*.tsx,hostflow-frontend/**/*.css
alwaysApply: false
