hostflow.cc, www.hostflow.cc {
    encode gzip
    header {
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Embedder-Policy "require-corp"
        Cross-Origin-Resource-Policy "same-origin"
        Content-Security-Policy "child-src 'self' blob:; frame-src 'self' blob:"
    }

    # Scanner service
    @scanner path /scan/*
    handle @scanner {
        reverse_proxy scanner-api:8000
    }

    # Scanner uploads
    @scan_uploads path /api/uploads/scanner/*
    handle @scan_uploads {
        reverse_proxy scanner-api:8000
    }

    # Backend API
    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    # Статика Vite: длинный кеш (имена файлов с хэшем). Иначе не трогаем — см. ниже.
    handle /assets/* {
        root * /var/www/hostflow-frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # SPA: index.html и fallback для /app/* без кеша — иначе браузер держит старый shell и грузит старый index-*.js («нет изменений»).
    handle {
        root * /var/www/hostflow-frontend
        header Cache-Control "no-cache, no-store, must-revalidate"
        try_files {path} /index.html
        file_server
    }

}
